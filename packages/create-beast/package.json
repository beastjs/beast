{
  "name": "create-beast",
  "version": "0.12.1",
  "description": "Create a Beast and Octane TSRX project.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "create-beast": "dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "template-tailwind",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "prepack": "bun run build",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "create-beast",
    "btsx",
    "tsrx",
    "octane",
    "vite"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beastjs/beast.git",
    "directory": "packages/create-beast"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1"
  }
}
