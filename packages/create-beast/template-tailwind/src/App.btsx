import { useState } from 'octane'

module
  type ViewId = 'reviews' | 'solve' | 'prevent'

  interface Props {
    docsUrl: string
  }

  interface Panel {
    id: ViewId
    label: string
    issueTitle: string
    issueCopy: string
    tags: string[]
    finding: string
    outcomeTitle: string
    outcomeCopy: string
    releaseNote: string
    status: string
    action: string
  }

  const panels: Panel[] = [
    {
      id: 'reviews',
      label: 'Reviews',
      issueTitle: 'Deployment (v2.8.5) added uncached lookups',
      issueCopy: 'Requests are overloading the database, causing latency spikes and broken frontend responses.',
      tags: ['v2.8.5', 'Open source', 'database'],
      finding: '27 spikes found',
      outcomeTitle: 'Secure deployment',
      outcomeCopy: 'No deploys with uncached fetches. CI must load-test any component that pulls user data on render.',
      releaseNote: 'v2.8.6 securely encrypted',
      status: 'Deployed',
      action: 'Restart investigation'
    },
    {
      id: 'solve',
      label: 'Solve',
      issueTitle: 'API retries are multiplying write load',
      issueCopy: 'A failed response triggers duplicate writes before the original request has finished processing.',
      tags: ['API', 'Payments', 'retries'],
      finding: '8 traces linked',
      outcomeTitle: 'Contain duplicate writes',
      outcomeCopy: 'Attach an idempotency key to every mutation and collapse matching requests at the edge.',
      releaseNote: 'Patch ready for review',
      status: 'Investigating',
      action: 'Open trace'
    },
    {
      id: 'prevent',
      label: 'Prevent',
      issueTitle: 'Checkout cache expires during traffic peaks',
      issueCopy: 'A synchronized cache refresh sends every checkout request back to the primary database.',
      tags: ['Checkout', 'Cache', 'traffic'],
      finding: '3 paths exposed',
      outcomeTitle: 'Guard the hot path',
      outcomeCopy: 'Stagger cache expiry and serve stale values while a single background refresh completes.',
      releaseNote: 'Policy active in production',
      status: 'Protected',
      action: 'View policy'
    }
  ]

props { docsUrl }: Props
setup const [activeId, setActiveId] = useState<ViewId>('reviews');
setup const active = panels.find((panel) => panel.id === activeId) ?? panels[0];

main(className='grid min-h-screen min-w-80 place-items-center p-3 sm:p-8 lg:p-16')
  section(
    ~ aria-labelledby="showcase-title"
    ~ className='w-full max-w-[1080px] overflow-hidden rounded-[1.75rem] border border-white/85 bg-white/75 p-4 shadow-[0_24px_55px_rgba(28,28,25,0.09)] backdrop-blur-xl sm:rounded-[2.8rem] sm:p-6 lg:p-8'
    ~ )
    header(className='flex flex-col items-start justify-between gap-6 px-1 pb-6 pt-2 md:flex-row md:items-center md:gap-8 md:px-3 md:pb-8 md:pt-3')
      h1#showcase-title(className='m-0 max-w-xl text-[clamp(1.7rem,3.3vw,2.7rem)] font-medium leading-[1.08] tracking-[-0.045em] text-[#161616]')
        span(className='block text-[#aaa9a6]') Smarter systems spot problems
        |  — and solve them.
      nav(className='inline-flex w-full shrink-0 items-center rounded-full border border-black/[0.025] bg-[#f0f0ee] p-1 md:w-auto' aria-label="Product workflow" role="tablist")
        each panel in panels key panel.id
          button(
            ~ type="button"
            ~ id={`tab-${panel.id}`}
            ~ role="tab"
            ~ aria-controls="workflow-panel"
            ~ aria-selected={activeId === panel.id}
            ~ className={activeId === panel.id ? 'inline-flex min-w-0 flex-1 cursor-pointer items-center justify-center gap-2 rounded-full border-0 bg-white/95 px-2.5 py-3 text-xs font-semibold text-[#242422] shadow-[0_1px_4px_rgba(26,26,24,0.14)] outline-none transition focus-visible:ring-3 focus-visible:ring-orange-200 sm:px-4 sm:text-sm md:min-w-24' : 'inline-flex min-w-0 flex-1 cursor-pointer items-center justify-center gap-2 rounded-full border-0 bg-transparent px-2.5 py-3 text-xs font-semibold text-[#595956] outline-none transition hover:text-[#111] focus-visible:ring-3 focus-visible:ring-orange-200 sm:px-4 sm:text-sm md:min-w-24'}
            ~ onClick={() => setActiveId(panel.id)}
            ~ )
            if panel.id === 'reviews'
              span(className='size-2 rounded-full bg-[#ff793f] shadow-[0_0_0_4px_rgba(255,121,63,0.1)]' aria-hidden="true")
            | #{panel.label}

    section#workflow-panel(
      ~ role="tabpanel"
      ~ aria-live="polite"
      ~ aria-labelledby={`tab-${activeId}`}
      ~ className='grid grid-cols-1 gap-4 rounded-3xl bg-[#eeeeeb]/90 p-2 sm:rounded-[2rem] sm:p-4 lg:grid-cols-[0.92fr_1.08fr]'
      ~ )
      article(className='flex min-h-[390px] flex-col justify-between rounded-[1.15rem] border border-black/8 bg-white/35 p-6 sm:min-h-[430px] sm:rounded-[1.45rem] sm:p-9 lg:min-h-[510px] lg:p-10')
        div
          p(className='mb-6 mt-0 text-[0.72rem] font-bold uppercase tracking-[0.11em] text-[#9b9b96]') Signal detected
          h2(className='m-0 max-w-sm text-[clamp(1.55rem,2.8vw,2.05rem)] font-medium leading-[1.16] tracking-[-0.035em] text-[#161616]') #{active.issueTitle}
          p(className='mb-0 mt-5 max-w-md text-base leading-relaxed text-[#73736f]') #{active.issueCopy}
          ul(className='mb-0 mt-9 flex list-none flex-wrap gap-2 p-0' aria-label="Issue tags")
            each tag, index in active.tags key tag
              li(className={index === 1 ? 'rounded-full border border-black/10 bg-[#f0f5e8] px-3 py-2 text-xs font-semibold text-[#3f3f3c] shadow-xs' : 'rounded-full border border-black/10 bg-white/65 px-3 py-2 text-xs font-semibold text-[#3f3f3c] shadow-xs'}) #{tag}
        footer(className='mt-12 flex items-center justify-between gap-4 text-sm text-[#a2a29e]')
          span #{active.finding}
          a(className='font-semibold text-[#343431] underline underline-offset-4 outline-none focus-visible:ring-3 focus-visible:ring-orange-200' href={docsUrl} target="_blank" rel="noreferrer") Read more

      article(className='flex min-h-[390px] flex-col rounded-[1.15rem] bg-[radial-gradient(circle_at_88%_10%,rgba(255,255,255,0.07),transparent_28rem),linear-gradient(145deg,#2a2b29,#111211_72%)] p-6 text-[#f6f6f2] shadow-[0_22px_36px_rgba(15,16,14,0.18)] sm:min-h-[430px] sm:rounded-[1.45rem] sm:p-9 lg:min-h-[510px] lg:p-10')
        div
          p(className='mb-6 mt-0 text-[0.72rem] font-bold uppercase tracking-[0.11em] text-[#858681]') Recommended guardrail
          h2(className='m-0 max-w-sm text-[clamp(1.55rem,2.8vw,2.05rem)] font-medium leading-[1.16] tracking-[-0.035em]') #{active.outcomeTitle}
          p(className='mb-0 mt-5 max-w-md text-base leading-relaxed text-[#a4a5a0]') #{active.outcomeCopy}
        p(className='mb-0 mt-auto pb-5 pt-12 text-sm text-[#858681]') #{active.releaseNote}
        footer(className='flex flex-col items-stretch justify-between gap-4 border-t border-white/[0.075] pt-6 sm:flex-row sm:items-center')
          span(className='inline-flex items-center justify-center gap-2 rounded-full bg-[#436f2a]/20 px-4 py-3 text-sm font-semibold text-[#c8f393]')
            span(className='grid size-[1.15rem] place-items-center rounded-full bg-[#b7ef75] text-xs font-black text-[#263d17]' aria-hidden="true") ✓
            | #{active.status}
          a(
            ~ className='inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[#f6f6f3] px-5 py-3 text-sm font-semibold text-[#282825] no-underline shadow-[0_3px_12px_rgba(0,0,0,0.24)] outline-none transition hover:-translate-y-px hover:bg-white focus-visible:ring-3 focus-visible:ring-orange-200'
            ~ href={docsUrl}
            ~ target="_blank"
            ~ rel="noreferrer"
            ~ )
            | #{active.action}
            span(aria-hidden="true") →
